# ===== 服务 =====
# 注意：3080 已被本系统 Web GUI 占用，后端默认 3081
PORT=3081

# ===== 运行模式 =====
# DEMO_MODE=true：不连数据库，聊天/知识库用本地 JSON 检索，认证自动放行（演示用）
# DEMO_MODE=false 且配置 DATABASE_URL：完整模式
DEMO_MODE=true

# ===== 数据库（完整模式）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taoteching

# ===== 认证 =====
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h

# ===== LLM（OpenAI 兼容接口，如 DeepSeek / 通义 / 豆包）=====
# 优先级：用户自定义模型（我的-大模型设置） > 管理后台模型配置（/admin/models） > 下方环境变量兜底
# 全部未配置时问答退化为"本地知识检索模式"（不调用大模型）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_LIGHT=deepseek-chat
LLM_MODEL_HEAVY=deepseek-reasoner
LLM_MODEL_EMBED=text-embedding-ada-002

# ===== 知识库 =====
KB_PATH=../knowledge-base/taoteching-wsy-2026.json

# ===== 认养照片上传 =====
# 上传文件存储目录（默认 <backend>/uploads/avatars）
# UPLOAD_DIR=/opt/daodejing-app/backend/uploads/avatars
# 照片公网访问基址：绝对 URL 则直接使用；相对路径则结合请求 Host 生成
# ASSET_PUBLIC_BASE=http://your-domain:port/uploads/avatars

# ===== 语音（预留）=====
ASR_PROVIDER=
TTS_PROVIDER=
